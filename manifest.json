{
  "manifest_version": 3,
  "name": "Detektor Persediaan Nota BMN (Non-AI CV + OCR)",
  "version": "1.0.0",
  "description": "Ekstraksi teks & tabel nota belanja menggunakan Computer Vision klasik + Tesseract OCR dan klasifikasi otomatis ke Kode Barang BMN_Persediaan.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "action": {
    "default_title": "Buka Detektor Nota Persediaan",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}